<Project Sdk="Microsoft.NET.Sdk.Web">
	<!-- Aplikacja do oglądania komponentów Tacit.Brand: dotnet run, projekt samples/Tacit.Brand.Sample
	     Referencja do projektu, nie do paczki, więc zmiany w web/ i src/Tacit.Brand widać od razu. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../../src/Tacit.Brand/Tacit.Brand.csproj" />
	</ItemGroup>
</Project>
