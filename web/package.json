{
  "name": "@tacitsoft/brand",
  "version": "0.0.0-dev",
  "description": "Marka Tacit: tokeny --tacit-*, fonty, style serwisu i adaptery Starlight/DocFX (ADR-C-0026).",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TacitSoft/brand.git",
    "directory": "web"
  },
  "publishConfig": {
