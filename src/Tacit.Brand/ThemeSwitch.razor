@*
    Przełącznik motywu: jasny / ciemny / systemowy.

    Renderuje sam znacznik, a obsługę daje tacit-theme.js (delegacja zdarzeń na document), więc działa w każdym
    trybie renderowania, także w statycznym SSR bez interaktywności. Nie dodawaj tu @rendermode ani @onclick.
    Ma atrybut hidden, który skrypt zdejmuje: bez JS przełącznika nie widać, a motyw idzie za systemem.

    Etykiety przekazuje rodzic (z IStringLocalizer). Domyślne są po polsku.
    Użycie w nagłówku:  <ThemeSwitch />   albo   <ThemeSwitch GroupLabel="@L["Theme"]" Light="@L["Light"]" … />
*@

<div class="t-segmented t-theme-switch" role="group" aria-label="@GroupLabel" data-tacit-theme-switch hidden>
    <button type="button" data-tacit-theme="light" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <span class="t-theme-switch__label">@Light</span>
    </button>
    <button type="button" data-tacit-theme="dark" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <span class="t-theme-switch__label">@Dark</span>
    </button>
    <button type="button" data-tacit-theme="system" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8M12 16v4" />
        </svg>
        <span class="t-theme-switch__label">@System</span>
    </button>
</div>

@code {
    [Parameter] public string GroupLabel { get; set; } = "Motyw";
    [Parameter] public string Light { get; set; } = "Jasny";
    [Parameter] public string Dark { get; set; } = "Ciemny";
    [Parameter] public string System { get; set; } = "Systemowy";
}
