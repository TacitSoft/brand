<Project Sdk="Microsoft.NET.Sdk.Razor">
	<!-- Razor Class Library z marką Tacit dla serwisu Blazor. Pliki statyczne nie leżą w tym projekcie:
	     jedynym źródłem jest katalog web/ (ten sam, z którego powstaje paczka npm @tacitsoft/brand).
	     Podpinamy je tu jako static web assets, więc w aplikacji są pod _content/Tacit.Brand/…  -->

	<PropertyGroup>
		<!-- Sam znacznik i pliki statyczne, bez kodu zależnego od wersji runtime, więc net10.0 obsługuje
		     też aplikacje na net11.0. -->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Tacit.Brand</RootNamespace>
		<PackageId>Tacit.Brand</PackageId>
		<Description>Marka Tacit dla Blazora: tokeny --tacit-*, fonty, style .t-*, przełącznik motywu i wspólne komponenty stron modułów (tabela, pole formularza, przycisk, komunikat, okruszki, menu obszaru).</Description>
		<RepositoryUrl>https://github.com/TacitSoft/brand</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Company>TacitSoft</Company>
		<Authors>Andrzej Świstowski</Authors>
		<Copyright>Copyright © 2026 TacitSoft</Copyright>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Wersja z tagu vX.Y.Z (ADR-C-0003). Ten sam tag daje wersję paczki npm. -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerVerbosity>minimal</MinVerVerbosity>
		<MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers Condition="'$(GITHUB_REF_TYPE)' != 'tag'">preview</MinVerDefaultPreReleaseIdentifiers>

		<BrandWebDir>$(MSBuildThisFileDirectory)../../web/</BrandWebDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
		<!-- Components.Web zamiast całego ASP.NET Core: komponent działa też w projekcie .Client (WebAssembly). -->
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- To, czego używa serwis. Adaptery Starlight/DocFX, podgląd i narzędzia zostają tylko w npm i repo.
		     ContentRoot = katalog pliku źródłowego: bez tego aplikacja z referencją do projektu (sample) szukałaby
		     plików w nieistniejącym src/Tacit.Brand/wwwroot. Paczka i tak dostaje kopie plików. -->
		<Content Include="$(BrandWebDir)tacit-tokens.css;$(BrandWebDir)tacit-fonts.css;$(BrandWebDir)tacit-site.css;$(BrandWebDir)tacit-theme.js"
		         Link="wwwroot/%(Filename)%(Extension)"
		         ContentRoot="%(RootDir)%(Directory)" />
		<Content Include="$(BrandWebDir)fonts/*.woff2;$(BrandWebDir)fonts/OFL-*.txt"
		         Link="wwwroot/fonts/%(Filename)%(Extension)"
		         ContentRoot="%(RootDir)%(Directory)" />
		<Content Include="$(MSBuildThisFileDirectory)../../favicon.ico;$(MSBuildThisFileDirectory)../../icon-rounded.svg;$(MSBuildThisFileDirectory)../../icon-rounded-180.png;$(MSBuildThisFileDirectory)../../icon-rounded-192.png;$(MSBuildThisFileDirectory)../../icon-rounded-512.png"
		         Link="wwwroot/icons/%(Filename)%(Extension)"
		         ContentRoot="%(RootDir)%(Directory)" />

		<None Include="$(MSBuildThisFileDirectory)../../icon-rounded-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<!-- Ostrzeżenie TBRAND001 o hexie w *.razor.css u odbiorców paczki (także przechodnich). -->
		<None Include="buildTransitive/Tacit.Brand.targets" Pack="true" PackagePath="buildTransitive/" />
		<None Include="App.razor.example" />
		<InternalsVisibleTo Include="Tacit.Brand.Tests" />
	</ItemGroup>
</Project>
